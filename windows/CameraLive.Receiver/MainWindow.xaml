<Window x:Class="CameraLive.Receiver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Camera Live Pro Receiver" Width="980" Height="660" MinWidth="820" MinHeight="560"
        Background="#0F1419" Foreground="#E8EEF4" FontFamily="Segoe UI">
  <Window.Resources>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E8EEF4"/></Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Background" Value="#1F6FEB"/><Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
  </Window.Resources>
  <Grid Margin="16">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="150"/></Grid.RowDefinitions>

    <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,12">
      <TextBlock Text="Camera Live Pro Receiver" FontSize="22" FontWeight="SemiBold"/>
      <TextBlock x:Name="StatusText" Text="Iniciando…" Foreground="#7EE787" FontSize="14" Margin="0,4,0,0"/>
    </StackPanel>

    <Border Grid.Row="1" Background="#000" CornerRadius="6" Margin="0,0,12,12">
      <Grid>
        <Image x:Name="PreviewImage" Stretch="Uniform"/>
        <TextBlock x:Name="NoVideoText" Text="Sem vídeo. Abra o app no celular e digite o código." 
                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#8B98A5"/>
      </Grid>
    </Border>

    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,12">
      <TextBlock Text="CÓDIGO DE PAREAMENTO" FontSize="11" Foreground="#8B98A5"/>
      <TextBlock x:Name="CodeText" FontSize="34" FontFamily="Consolas" FontWeight="Bold" Margin="0,2,0,6"/>
      <Button Content="Gerar novo código" Click="NewCode_Click" HorizontalAlignment="Left"/>
      <TextBlock Text="ENDEREÇOS DESTE COMPUTADOR" FontSize="11" Foreground="#8B98A5" Margin="0,14,0,2"/>
      <TextBlock x:Name="AddressText" TextWrapping="Wrap" FontFamily="Consolas"/>
      <TextBlock Text="ESTATÍSTICAS" FontSize="11" Foreground="#8B98A5" Margin="0,14,0,2"/>
      <TextBlock x:Name="StatsText" TextWrapping="Wrap" FontFamily="Consolas" Text="—"/>
      <TextBlock Text="SAÍDA PARA O OBS / vMix" FontSize="11" Foreground="#8B98A5" Margin="0,14,0,2"/>
      <TextBox x:Name="ObsUrl" IsReadOnly="True" Text="tcp://127.0.0.1:47810" FontFamily="Consolas" Margin="0,0,0,6"/>
      <StackPanel Orientation="Horizontal">
        <Button Content="Copiar URL" Click="CopyUrl_Click"/>
        <Button Content="Como usar no OBS" Click="Help_Click" Background="#30363D"/>
      </StackPanel>
      <TextBlock x:Name="RelayText" Foreground="#8B98A5" Margin="0,6,0,0" Text="OBS conectado: não"/>
    </StackPanel>

    <Grid Grid.Row="2" Grid.ColumnSpan="2">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Registro (para suporte)" FontSize="11" Foreground="#8B98A5" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <Button Content="Abrir pasta de logs" Click="OpenLogs_Click" Background="#30363D" Padding="8,2"/>
        <Button Content="Diagnóstico de rede" Click="Diag_Click" Background="#30363D" Padding="8,2"/>
      </StackPanel>
      <ListBox x:Name="LogList" Grid.Row="1" Background="#0A0E12" Foreground="#B6C2CE" FontFamily="Consolas" FontSize="11" BorderThickness="0"/>
    </Grid>
  </Grid>
</Window>
